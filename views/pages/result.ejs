<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head') %>
</head>

<body class="container">
    <header>
        <%- include('../partials/header') %>
    </header>
    <main>
        <div class="jumbotron text-center">
            <div class="table-responsive">
                <table class="table table-warning table-hover">
                    <tr>
                        <th>QTÉ</th>
                        <th>PIZZA</th>
                        <th>PRIX UNIT. HT</th>
                        <th>MONTANT HT</th>
                    </tr>
                    <tr>
                        <td>
                            <%= commande.quantite %>
                        </td>
                        <td>
                            <%= commande.type %>
                        </td>
                        <td>
                            <%= commande.prixUnitaire.toFixed(2) %>$
                        </td>
                        <td>
                            <%= commande.totalPizza.toFixed(2) %>$
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td class="font-weight-bold">TAXE</td>
                        <td>
                            <%= commande.taxe.toFixed(2) %>$
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td class="font-weight-bold">TOTAL</td>
                        <td>
                            <%= commande.total.toFixed(2) %>$
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </main>
    <footer>
        <%- include('../partials/footer') %>
    </footer>
</body>

</html>