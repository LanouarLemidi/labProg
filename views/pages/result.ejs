<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head') %>
</head>

<body class="container">
    <header>
        <%- include('../partials/header') %>
    </header>
    <main>
        <div class="jumbotron text-center">
            <table class="table table-warning table-hover">
                <tr>
                    <th>QTÉ</th>
                    <th>PRODUIT</th>
                    <th>PRIX UNIT. HT</th>
                    <th>MONTANT HT</th>
                </tr>
                <tr>
                    <td>
                        <%= commande.quantite %>
                    </td>
                    <td>
                        <%= commande.type %>
                    </td>
                    <td>
                        <%= commande.prixUnitaire.toFixed(2) %>$
                    </td>
                    <td>
                        <%= commande.totalPizza.toFixed(2) %>$
                    </td>
                </tr>
                <tr>
                    <td>
                        <%= commande.quantiteExtra %>
                    </td>
                    <td>extra</td>
                    <td>0.50$</td>
                    <td>
                        <%= commande.prixExtras.toFixed(2) %>$
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td>Total HT</td>
                    <td>
                        <%= commande.totalAvantTaxe.toFixed(2) %>$
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td>Taxe</td>
                    <td>
                        <%= commande.taxe.toFixed(2) %>$
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td></td>
                    <td class="font-weight-bold">TOTAL</td>
                    <td>
                        <%= commande.total.toFixed(2) %>$
                    </td>
                </tr>
            </table>
        </div>
    </main>
    <footer>
        <%- include('../partials/footer') %>
    </footer>
</body>

</html>